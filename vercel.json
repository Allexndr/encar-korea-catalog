{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/index.js"
        },
        {
            "source": "/car.html",
            "destination": "/index.js"
        },
        {
            "source": "/car",
            "destination": "/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.js"
        }
    ]
}